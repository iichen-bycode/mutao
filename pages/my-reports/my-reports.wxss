.records-page { padding-bottom:150rpx; }.page-title { margin:6rpx 0; color:#5A4A48; font-size:36rpx; font-weight:740; }.page-intro { margin-bottom:20rpx; color:#806C6A; font-size:21rpx; }
.record-list { display:flex; flex-direction:column; gap:12rpx; }.record-card { padding:21rpx; border-radius:28rpx; }.record-head { display:flex; align-items:flex-start; gap:12rpx; }.record-title { min-width:0; flex:1; color:#5A4A48; font-size:24rpx; font-weight:700; }.report-status { flex:none; }.record-community { margin-top:7rpx; color:#947C7A; font-size:18rpx; }.record-reason { margin-top:14rpx; padding:13rpx 15rpx; border-radius:16rpx; background:#FFF7F1; color:#5A4A48; font-size:21rpx; line-height:1.6; word-break:break-word; }.record-link { margin-top:13rpx; color:#B17D75; text-align:right; font-size:18rpx; }.record-link text { margin-left:4rpx; font-size:25rpx; }
.skeleton-record { display:flex; flex-direction:column; gap:14rpx; }.skeleton-line { width:75%; height:17rpx; border-radius:100rpx; background:linear-gradient(90deg,#FFF7F1 0%,#FCD5CE 50%,#FFF7F1 100%); background-size:200% 100%; animation:skeleton-shimmer 1.35s ease-in-out infinite; }.short-line { width:45%; }
