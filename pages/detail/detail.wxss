.detail-page { min-height: 100vh; box-sizing: border-box; padding: 0 0 155rpx; }
.gallery,.gallery-placeholder { width: 100%; height: 620rpx; overflow: hidden; border-radius: 0 0 48rpx 48rpx; background: #FCD5CE; }
.gallery-image { width: 100%; height: 100%; }
.gallery-placeholder { display: flex; flex-direction: column; align-items: center; justify-content: center; color: #947C7A; font-size: 21rpx; }
.placeholder-icon { display: flex; align-items: center; justify-content: center; width: 78rpx; height: 78rpx; margin-bottom: 12rpx; border-radius: 30rpx; background: #FCD5CE; color: #5A4A48; font-size: 34rpx; font-weight: 700; }
.price-card,.seller-card,.description,.contact-card { margin: 16rpx 20rpx 0; padding: 22rpx; border: 1rpx solid #FCD5CE; border-radius: 48rpx; background: #FFFFFF; box-shadow: 0 8rpx 28rpx rgba(255,181,167,.12); }
.price-card { position: relative; }
.price { color: #5A4A48; font-size: 43rpx; line-height: 1.2; font-weight: 800; }
.price text { margin-right: 5rpx; color: #FF8FA3; font-size: 23rpx; }
.price-card > .status { position: absolute; top: 23rpx; right: 21rpx; }
.title { margin: 14rpx 0 10rpx; color: #5A4A48; font-size: 28rpx; line-height: 1.45; font-weight: 700; }
.meta-row { display: flex; align-items: center; gap: 8rpx; color: #947C7A; font-size: 20rpx; }
.meta-pill { padding: 5rpx 11rpx; border-radius: 100rpx; background: #FCD5CE; color: #5A4A48; }
.meta-dot { color: #947C7A; }
.moderation-note { display: flex; flex-direction: column; gap: 5rpx; margin-top: 17rpx; padding: 13rpx 15rpx; border-radius: 13rpx; background: #FFD6A5; color: #5A4A48; font-size: 21rpx; }
.note-label { font-size: 20rpx; font-weight: 700; }
.seller-card { display: flex; align-items: center; }
.avatar { width: 66rpx; height: 66rpx; flex: none; margin-right: 14rpx; border-radius: 50%; background: #FCD5CE; }
.avatar-fallback { display: flex; align-items: center; justify-content: center; color: #5A4A48; font-size: 25rpx; font-weight: 700; }
.seller-info { min-width: 0; flex: 1; }
.seller-name { color: #5A4A48; font-size: 23rpx; font-weight: 680; }
.seller-meta { overflow: hidden; margin-top: 4rpx; font-size: 20rpx; text-overflow: ellipsis; white-space: nowrap; }
.block-title { margin-bottom: 12rpx; color: #5A4A48; font-size: 24rpx; font-weight: 700; }
.description-text { color: #5A4A48; font-size: 22rpx; line-height: 1.75; white-space: pre-wrap; word-break: break-word; }
.contact-card { border-color: #FCD5CE; background: #FFFFFF; }
.contact-head { display: flex; align-items: center; justify-content: space-between; }
.contact-head .block-title { margin-bottom: 9rpx; }
.contact-action { padding: 6rpx 13rpx; border-radius: 100rpx; background: #A7D7A1; color: #5A4A48; font-size: 20rpx; }
.contact-value { margin-bottom: 4rpx; color: #5A4A48; font-size: 23rpx; font-weight: 680; }
.report-link { min-height: 83rpx; padding: 22rpx; color: #947C7A; text-align: center; font-size: 20rpx; }
.bottom-actions { position: fixed; z-index: 10; right: 0; bottom: 0; left: 0; display: flex; gap: 12rpx; padding: 13rpx 20rpx calc(13rpx + env(safe-area-inset-bottom)); border-top: 1rpx solid #FCD5CE; background: rgba(255,247,241,.97); }
.action-button { height: 78rpx; border-radius: 32rpx; font-size: 22rpx; transition: all 0.22s ease-out; }
.favorite { width: 196rpx; background: #FCD5CE; color: #5A4A48; }
.favorite-star { display: inline-block; margin-right: 6rpx; color: #FF8FA3; font-size: 25rpx; }
.heart-bounce { animation: heart-bounce 420ms cubic-bezier(.2,.8,.25,1) 1; }
.message-button { flex: 1; }
.owner-actions .action-button { width: 100%; }
.state-panel { margin: 95rpx 26rpx 0; }
.detail-skeleton { min-height: 100vh; padding-bottom: 45rpx; }
.skeleton-gallery { width: 100%; height: 620rpx; border-radius: 0 0 48rpx 48rpx; }
.skeleton-detail-card { display: flex; flex-direction: column; gap: 15rpx; margin: 16rpx 20rpx 0; padding: 25rpx 22rpx; border-radius: 48rpx; }
.skeleton-price-line { width: 38%; height: 35rpx; margin-bottom: 5rpx; }
.skeleton-detail-card .skeleton-line:not(.skeleton-price-line) { width: 88%; }
.skeleton-detail-card .short-line { width: 55% !important; }
.skeleton-seller-card { display: flex; align-items: center; gap: 15rpx; margin: 16rpx 20rpx 0; padding: 20rpx; border-radius: 48rpx; }
.skeleton-avatar { width: 66rpx; height: 66rpx; flex: none; border-radius: 50%; }
.skeleton-seller-card .skeleton-copy { display: flex; flex: 1; flex-direction: column; gap: 12rpx; }
.skeleton-seller-card .skeleton-line:first-child { width: 48%; }
.skeleton-seller-card .short-line { width: 75%; }
