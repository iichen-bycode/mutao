.detail-page { min-height: 100vh; box-sizing: border-box; padding: 0 0 155rpx; }
.gallery-shell { position: relative; width: 100%; height: 590rpx; overflow: hidden; background: #FCD5CE; }
.gallery,.gallery-placeholder { width: 100%; height: 100%; overflow: hidden; background: #FCD5CE; }
.gallery-image { width: 100%; height: 100%; }
.gallery-placeholder { display: flex; flex-direction: column; align-items: center; justify-content: center; color: #947C7A; font-size: 21rpx; }
.gallery-image-placeholder { display: flex; flex-direction: column; align-items: center; justify-content: center; width: 100%; height: 100%; color: #947C7A; font-size: 21rpx; }
.placeholder-icon { display: flex; align-items: center; justify-content: center; width: 78rpx; height: 78rpx; margin-bottom: 12rpx; border-radius: 30rpx; background: #FFF7F1; color: #5A4A48; font-size: 34rpx; font-weight: 700; }
.gallery-count { position: absolute; right: 20rpx; bottom: 22rpx; min-width: 70rpx; padding: 7rpx 13rpx; border-radius: 100rpx; background: rgba(45,35,34,.58); color: #FFFFFF; text-align: center; font-size: 19rpx; line-height: 1.3; }
.gallery-status { position: absolute; top: 22rpx; left: 22rpx; padding: 8rpx 15rpx; border-radius: 100rpx; background: rgba(45,35,34,.65); color: #FFFFFF; font-size: 20rpx; }
.price-card,.seller-card,.description,.contact-card { margin: 16rpx 18rpx 0; padding: 22rpx; border: 1rpx solid #FCD5CE; border-radius: 34rpx; background: #FFFFFF; box-shadow: 0 8rpx 28rpx rgba(255,181,167,.12); }
.price-card { position: relative; }
.price-line { display: flex; align-items: baseline; gap: 15rpx; }
.price { color: #FF697F; font-size: 43rpx; line-height: 1.2; font-weight: 800; }
.price text { margin-right: 4rpx; font-size: 23rpx; }
.original-price { color: #947C7A; font-size: 20rpx; text-decoration: line-through; }
.title { margin: 13rpx 0 9rpx; color: #5A4A48; font-size: 27rpx; line-height: 1.45; font-weight: 700; }
.meta-row { display: flex; align-items: center; gap: 8rpx; color: #947C7A; font-size: 20rpx; }
.meta-pill { padding: 5rpx 11rpx; border-radius: 100rpx; background: #FFF0EA; color: #B36F72; }
.meta-delivery { flex:none; padding:5rpx 11rpx; border-radius:100rpx; background:#E9F7EC; color:#64A77A; }
.meta-dot { margin: 0 3rpx; color: #C5AAA4; }
.activity-meta { display: flex; align-items: center; gap: 7rpx; margin-top: 12rpx; color: #947C7A; font-size: 19rpx; }
.meta-pin { position: relative; width: 12rpx; height: 12rpx; margin: 0 3rpx; border: 2rpx solid #FF8FA3; border-radius: 50% 50% 50% 0; transform: rotate(-45deg); }
.meta-heart { color: #FF8FA3; font-size: 21rpx; }
.status-line { margin-top: 10rpx; }
.moderation-note { display: flex; flex-direction: column; gap: 5rpx; margin-top: 14rpx; padding: 12rpx 14rpx; border-radius: 13rpx; background: #FFD6A5; color: #5A4A48; font-size: 20rpx; }
.note-label { font-size: 20rpx; font-weight: 700; }
.spec-grid { display: flex; gap: 10rpx; margin-top: 17rpx; }
.spec-cell { display: flex; flex: 1; min-width: 0; flex-direction: column; align-items: center; justify-content: center; min-height: 91rpx; padding: 8rpx 5rpx; border-radius: 22rpx; background: #FFF7F4; }
.spec-label { color: #947C7A; font-size: 19rpx; }
.spec-value { max-width: 100%; overflow: hidden; margin-top: 3rpx; color: #5A4A48; font-size: 21rpx; font-weight: 700; text-overflow: ellipsis; white-space: nowrap; }
.description { padding: 22rpx; }
.block-title { margin-bottom: 10rpx; color: #5A4A48; font-size: 24rpx; font-weight: 700; }
.description-text { color: #6F5D5A; font-size: 21rpx; line-height: 1.75; white-space: pre-wrap; word-break: break-word; }
.seller-card { display: flex; align-items: center; min-height: 108rpx; }
.avatar { width: 66rpx; height: 66rpx; flex: none; margin-right: 14rpx; border-radius: 50%; background: #FBC7B3; }
.avatar-fallback { display: flex; align-items: center; justify-content: center; color: #FFFFFF; font-size: 25rpx; font-weight: 700; }
.seller-info { min-width: 0; flex: 1; }
.seller-name { color: #5A4A48; font-size: 22rpx; font-weight: 700; }
.seller-meta { overflow: hidden; margin-top: 4rpx; font-size: 19rpx; text-overflow: ellipsis; white-space: nowrap; }
.seller-message { width: 88rpx; height: 56rpx; flex: none; margin-left: 12rpx; padding: 0; border: 1rpx solid #FF8FA3; border-radius: 100rpx; background: #FFFFFF; color: #F16F7F; font-size: 20rpx; line-height: 54rpx; }
.contact-card { border-color: #FCD5CE; background: #FFFFFF; }
.contact-head { display: flex; align-items: center; justify-content: space-between; }
.contact-head .block-title { margin-bottom: 9rpx; }
.contact-action { padding: 6rpx 13rpx; border-radius: 100rpx; background: #E9F7EC; color: #5A4A48; font-size: 20rpx; }
.contact-value { margin-bottom: 4rpx; color: #5A4A48; font-size: 23rpx; font-weight: 680; }
.report-link { min-height: 77rpx; padding: 20rpx; color: #947C7A; text-align: center; font-size: 20rpx; }
.bottom-actions { position: fixed; z-index: 10; right: 0; bottom: 0; left: 0; display: flex; gap: 12rpx; padding: 13rpx 20rpx calc(13rpx + env(safe-area-inset-bottom)); border-top: 1rpx solid #FCD5CE; background: rgba(255,247,241,.97); }
.action-button { height: 78rpx; border-radius: 100rpx; font-size: 22rpx; transition: all 0.22s ease-out; }
.favorite { width: 196rpx; border: 1rpx solid #FF8FA3; background: #FFFFFF; color: #5A4A48; }
.favorite-star { display: inline-block; margin-right: 6rpx; color: #FF697F; font-size: 25rpx; }
.heart-bounce { animation: heart-bounce 420ms cubic-bezier(.2,.8,.25,1) 1; }
.message-button { display: flex; align-items: center; justify-content: center; flex: 1; background: #F58F95; color: #FFFFFF; font-weight: 700; }
.chat-icon { position: relative; width: 22rpx; height: 16rpx; margin-right: 9rpx; border: 2rpx solid currentColor; border-radius: 7rpx; }
.chat-icon::after { position: absolute; bottom: -5rpx; left: 4rpx; width: 6rpx; height: 6rpx; border-left: 2rpx solid currentColor; background: #F58F95; content: ''; transform: skewY(-35deg); }
.owner-actions .action-button { display:flex; align-items:center; justify-content:center; width:100%; padding:0; line-height:1.2; text-align:center; }
.state-panel { margin: 95rpx 26rpx 0; }
.detail-skeleton { min-height: 100vh; padding-bottom: 45rpx; }
.skeleton-gallery { width: 100%; height: 590rpx; }
.skeleton-detail-card { display: flex; flex-direction: column; gap: 15rpx; margin: 16rpx 18rpx 0; padding: 25rpx 22rpx; border-radius: 34rpx; }
.skeleton-price-line { width: 38%; height: 35rpx; margin-bottom: 5rpx; }
.skeleton-detail-card .skeleton-line:not(.skeleton-price-line) { width: 88%; }
.skeleton-detail-card .short-line { width: 55% !important; }
.skeleton-seller-card { display: flex; align-items: center; gap: 15rpx; margin: 16rpx 18rpx 0; padding: 20rpx; border-radius: 34rpx; }
.skeleton-avatar { width: 66rpx; height: 66rpx; flex: none; border-radius: 50%; }
.skeleton-seller-card .skeleton-copy { display: flex; flex: 1; flex-direction: column; gap: 12rpx; }
.skeleton-seller-card .skeleton-line:first-child { width: 48%; }
.skeleton-seller-card .short-line { width: 75%; }
@media (prefers-reduced-motion: reduce) { .heart-bounce,.pressed,.page-enter { animation: none !important; transition: none !important; } }
