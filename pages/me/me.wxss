.me-page { padding: 30rpx 26rpx 145rpx; }
.profile-heading { margin: 0 3rpx 18rpx; }
.page-eyebrow { margin-bottom: 4rpx; color: #5A4A48; font-size: 20rpx; font-weight: 700; }
.page-title { color: #5A4A48; font-size: 37rpx; line-height: 1.3; font-weight: 760; }
.profile-card { display: flex; align-items: center; margin-bottom: 13rpx; padding: 20rpx; border-color: #FCD5CE; background: #FFFFFF; box-shadow: 0 8rpx 28rpx rgba(255,181,167,.12); }
.avatar { width: 77rpx; height: 77rpx; flex: none; margin-right: 15rpx; border-radius: 50%; background: #FCD5CE; }
.avatar-fallback { display: flex; align-items: center; justify-content: center; border: 2rpx solid rgba(255,181,167,.24); color: #5A4A48; font-size: 29rpx; font-weight: 750; }
.profile-info { min-width: 0; flex: 1; }
.profile-card .name { overflow: hidden; margin-bottom: 4rpx; color: #5A4A48; font-size: 25rpx; font-weight: 720; text-overflow: ellipsis; white-space: nowrap; }
.profile-card .muted { font-size: 20rpx; }
.member-mark { flex: none; margin-left: 9rpx; padding: 7rpx 10rpx; border-radius: 100rpx; background: #fff; color: #5A4A48; font-size: 20rpx; }
.quick-actions { margin-bottom: 25rpx; padding: 0 18rpx; }
.quick-row { display: flex; align-items: center; min-height: 88rpx; border-bottom: 1rpx solid #FCD5CE; }
.quick-row:last-child { border-bottom: 0; }
.quick-icon { display: flex; align-items: center; justify-content: center; width: 52rpx; height: 52rpx; flex: none; margin-right: 13rpx; border-radius: 23rpx; font-size: 20rpx; font-weight: 700; }
.message-icon { background: #FCD5CE; color: #FF8FA3; }
.publish-icon { background: #FCD5CE; color: #FF8FA3; }
.quick-copy { flex: 1; }
.quick-title { color: #5A4A48; font-size: 22rpx; font-weight: 680; }
.quick-hint { margin-top: 3rpx; color: #947C7A; font-size: 20rpx; }
.arrow { margin-left: auto; color: #947C7A; font-size: 30rpx; }
.listing-heading { display: flex; align-items: center; justify-content: space-between; margin: 0 2rpx 10rpx; }
.listing-heading .section-title { font-size: 28rpx; }
.listing-count { color: #947C7A; font-size: 20rpx; }
.mode-tabs { position: relative; display: flex; gap: 6rpx; margin-bottom: 13rpx; border-bottom: 1rpx solid #FCD5CE; }
.mode-tabs::after { position: absolute; bottom: -1rpx; left: 0; width: 50%; height: 5rpx; border-radius: 5rpx; background: #FF8FA3; content: ''; transition: all 0.22s ease-out; }
.mode-tabs.favorites-active::after { transform: translateX(100%); }
.mode-tab { flex: 1; min-width: 0; padding: 15rpx 16rpx; color: #947C7A; text-align: center; font-size: 20rpx; transition: all 0.22s ease-out; }
.mode-active { color: #5A4A48; font-weight: 700; }
.tab-pressed { opacity: .72; }
.listing-list { display: flex; flex-direction: column; gap: 10rpx; }
.my-listing { display: flex; align-items: center; min-height: 126rpx; padding: 13rpx; border-radius: 48rpx; transition: all 0.22s ease-out; }
.listing-pressed { transform: translateY(-12rpx); box-shadow: 0 12rpx 40rpx rgba(255,181,167,.18); }
.my-listing-image { width: 98rpx; height: 98rpx; flex: none; margin-right: 13rpx; border-radius: 24rpx; background: #FCD5CE; }
.my-listing-image.placeholder { display: flex; align-items: center; justify-content: center; color: #947C7A; font-size: 25rpx; }
.my-listing-main { min-width: 0; flex: 1; }
.my-listing .title { overflow: hidden; margin-bottom: 5rpx; color: #5A4A48; font-size: 22rpx; font-weight: 650; text-overflow: ellipsis; white-space: nowrap; }
.listing-meta { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 20rpx; }
.status { margin-top: 6rpx; }
.sold-button { flex: none; min-height: 54rpx; margin-left: 8rpx; padding: 0 15rpx; border-radius: 32rpx; background: #FCD5CE; color: #5A4A48; font-size: 20rpx; }
.state-panel { margin-top: 13rpx; }
.state-icon { display: flex; align-items: center; justify-content: center; width: 78rpx; height: 78rpx; margin: 0 auto 16rpx; border-radius: 30rpx; background: #FCD5CE; color: #5A4A48; font-size: 32rpx; font-weight: 700; animation: empty-float 1.8s ease-in-out 2; }
.state-action { min-width: 216rpx; height: 72rpx; margin-top: 22rpx; padding: 0 24rpx; font-size: 22rpx; }
.skeleton-me { display: flex; flex-direction: column; gap: 12rpx; }
.skeleton-thumb { width: 98rpx; height: 98rpx; flex: none; margin-right: 13rpx; border-radius: 23rpx; }
.skeleton-me .skeleton-copy { display: flex; flex: 1; flex-direction: column; gap: 11rpx; padding: 0; }
.skeleton-me .skeleton-line:first-child { width: 80%; }
.skeleton-me .short-line { width: 56%; }
.skeleton-me .status-line { width: 31%; height: 15rpx; }
.stat-row { display:flex; gap:10rpx; margin:0 0 13rpx; }
.stat { flex:1; min-width:0; padding:14rpx 8rpx 12rpx; border-radius:26rpx; text-align:center; }
.stat-value { color:#F16F7F; font-size:29rpx; line-height:1.15; font-weight:760; }
.stat-label { margin-top:5rpx; color:#947C7A; font-size:18rpx; }
.history-icon { background:#FFF0E8; color:#F16F7F; }
.draft-icon { background:#FFE5D6; color:#BB7968; font-size:18rpx; font-weight:700; }
.history-glyph { position:relative; width:26rpx; height:26rpx; border:2rpx solid currentColor; border-radius:50%; }
.history-glyph::before { position:absolute; top:4rpx; left:11rpx; width:2rpx; height:8rpx; background:currentColor; content:''; }
.history-glyph::after { position:absolute; top:11rpx; left:11rpx; width:7rpx; height:2rpx; background:currentColor; content:''; transform:rotate(30deg); transform-origin:left center; }
.recent-section { margin:0 0 23rpx; }
.recent-heading { display:flex; align-items:center; justify-content:space-between; margin:0 2rpx 10rpx; }
.recent-heading .section-title { font-size:27rpx; }
.more-link { color:#947C7A; font-size:19rpx; }
.recent-scroll { margin:0 -26rpx; white-space:nowrap; }
.recent-row { display:inline-flex; gap:11rpx; padding:0 26rpx 3rpx; }
.recent-card { width:148rpx; flex:none; overflow:hidden; padding:9rpx; border-radius:25rpx; }
.recent-card image,.recent-placeholder { display:flex; align-items:center; justify-content:center; width:130rpx; height:118rpx; border-radius:18rpx; background:#FCD5CE; color:#FF8FA3; font-size:25rpx; font-weight:700; }
.recent-price { margin-top:8rpx; color:#F16F7F; font-size:21rpx; font-weight:750; }
.recent-title { overflow:hidden; margin-top:3rpx; color:#5A4A48; font-size:18rpx; text-overflow:ellipsis; white-space:nowrap; }
.status-scroll { margin:0 -26rpx 12rpx; white-space:nowrap; }
.status-row { display:inline-flex; gap:9rpx; padding:0 26rpx; }
.status-filter { padding:8rpx 16rpx; border:1rpx solid #FCD5CE; border-radius:100rpx; background:#fff; color:#947C7A; font-size:19rpx; transition:all .2s ease; }
.filter-active { border-color:#FF8FA3; background:#FF8FA3; color:#fff; }
.my-listing { animation:listing-in .3s ease-out both; }
@keyframes listing-in { from { opacity:0; transform:translateY(13rpx); } to { opacity:1; transform:translateY(0); } }
@media (prefers-reduced-motion: reduce) { .my-listing { animation:none!important; } }
