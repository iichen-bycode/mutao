<view class="page conversations-page page-enter">
  <view class="page-heading"><view class="page-eyebrow">睦淘社区 · 对话</view><view class="heading-row"><view class="page-title">邻里消息</view><text wx:if="{{items.length}}" class="message-count">{{items.length}} 段对话</text></view><view class="page-subtitle">关于好物的交流，都在这里继续</view></view>

  <view wx:if="{{items.length}}" class="conversation-list">
    <view wx:for="{{items}}" wx:key="id" class="conversation card" data-id="{{item.id}}" hover-class="conversation-pressed" hover-stay-time="100" bindtap="openChat">
      <image wx:if="{{item.other_avatar}}" class="avatar" src="{{item.other_avatar}}" mode="aspectFill" />
      <view wx:else class="avatar avatar-fallback">{{item.avatarInitial}}</view>
      <view class="conversation-main">
        <view class="top-row"><view class="name">{{item.other_nickname || '邻居'}}</view><text wx:if="{{item.timeLabel}}" class="muted time">{{item.timeLabel}}</text></view>
        <view class="product">聊聊：{{item.listing_title || '邻里好物'}}</view>
        <view class="bottom-row"><view class="last-message">{{item.last_message || '可以聊聊这件好物'}}</view><text class="arrow">›</text></view>
      </view>
    </view>
  </view>

  <view wx:elif="{{loading}}" class="conversation-list skeleton-conversations" aria-hidden="true">
    <view class="conversation card skeleton-conversation"><view class="skeleton-block skeleton-avatar"></view><view class="skeleton-copy"><view class="skeleton-line"></view><view class="skeleton-line short-line"></view><view class="skeleton-line"></view></view></view>
    <view class="conversation card skeleton-conversation"><view class="skeleton-block skeleton-avatar"></view><view class="skeleton-copy"><view class="skeleton-line"></view><view class="skeleton-line short-line"></view><view class="skeleton-line"></view></view></view>
    <view class="conversation card skeleton-conversation"><view class="skeleton-block skeleton-avatar"></view><view class="skeleton-copy"><view class="skeleton-line"></view><view class="skeleton-line short-line"></view><view class="skeleton-line"></view></view></view>
  </view>
  <view wx:elif="{{error}}" class="state-panel card"><view class="state-icon error-icon">!</view><view class="state-title">消息暂时无法加载</view><view class="state-copy">检查网络连接后再试一次</view><button class="primary state-action" hover-class="pressed" bindtap="retry">重新加载</button></view>
  <view wx:else class="state-panel card"><view class="state-icon">聊</view><view class="state-title">还没有聊天</view><view class="state-copy">打开一件好物，点“聊一聊”开始和邻居沟通</view></view>
</view>
