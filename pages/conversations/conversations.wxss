.inbox-page { padding: 0 20rpx 145rpx; }
.inbox-header { height: 62rpx; margin: 0 -20rpx 12rpx; padding-left: 30rpx; border-top-right-radius: 38rpx; background: #FFFFFF; }
.inbox-title { padding-top: 10rpx; color: #5A4A48; font-size: 27rpx; line-height: 1.4; font-weight: 700; }
.inbox-toolbar { display: flex; align-items: center; justify-content: space-between; min-height: 66rpx; margin: 0 2rpx 17rpx; }
.filter-list { display: flex; align-items: center; gap: 12rpx; }
.filter-chip { display: flex; align-items: center; justify-content: center; min-width: 65rpx; height: 48rpx; padding: 0 17rpx; border: 1rpx solid #F7E7E1; border-radius: 100rpx; background: #FFFFFF; color: #947C7A; font-size: 21rpx; transition: background-color .18s ease, color .18s ease, border-color .18s ease; }
.filter-active { border-color: #F28C9D; background: #F28C9D; color: #FFFFFF; }
.filter-pressed { opacity: .76; }
.read-all { flex: none; padding: 12rpx 2rpx 12rpx 10rpx; color: #C8737E; font-size: 19rpx; }
.read-all-disabled { opacity: .55; }
.read-all-pressed { opacity: .65; }
.inbox-card { overflow: hidden; border: 1rpx solid rgba(252,213,206,.55); border-radius: 28rpx; background: #FFFFFF; box-shadow: 0 7rpx 22rpx rgba(167,113,101,.055); }
.inbox-row { box-sizing: border-box; display: flex; align-items: center; min-height: 120rpx; padding: 16rpx 18rpx; transition: background-color .16s ease; }
.inbox-row::after { position: absolute; }
.inbox-row:not(.row-last) { border-bottom: 1rpx solid #F8EEEA; }
.row-last { border-bottom: 0; }
.message-pressed { background: #FFF9F6; }
.avatar { box-sizing: border-box; display: flex; align-items: center; justify-content: center; width: 58rpx; height: 58rpx; flex: none; margin-right: 17rpx; border-radius: 50%; background: #FCD5CE; }
.avatar-fallback { color: #FFFFFF; font-size: 23rpx; font-weight: 700; }
.avatar-tone-0 { background: #F18D99; }
.avatar-tone-1 { background: #8CCCA9; }
.avatar-tone-2 { background: #F7C891; }
.avatar-tone-3 { background: #B9A5D7; }
.system-avatar { background: #FFF2E4; }
.bell-icon { position: relative; box-sizing: border-box; width: 18rpx; height: 20rpx; border: 2rpx solid #E5A854; border-bottom: 0; border-radius: 11rpx 11rpx 4rpx 4rpx; }
.bell-icon::before { position: absolute; bottom: -5rpx; left: -5rpx; width: 24rpx; height: 5rpx; border-top: 2rpx solid #E5A854; border-radius: 50%; content: ''; }
.bell-icon::after { position: absolute; bottom: -9rpx; left: 5rpx; width: 5rpx; height: 3rpx; border-radius: 0 0 5rpx 5rpx; background: #E5A854; content: ''; }
.row-copy { min-width: 0; flex: 1; padding-right: 10rpx; }
.row-title-line { display: flex; align-items: center; min-width: 0; }
.row-title { overflow: hidden; max-width: 320rpx; color: #5A4A48; font-size: 24rpx; font-weight: 680; text-overflow: ellipsis; white-space: nowrap; }
.type-tag { flex: none; margin-left: 10rpx; padding: 2rpx 8rpx; border-radius: 7rpx; font-size: 17rpx; line-height: 1.45; }
.private-tag { background: #FFF0EF; color: #E8848F; }
.system-tag { background: #FFF5E8; color: #D79A4A; }
.row-preview { overflow: hidden; margin-top: 6rpx; color: #947C7A; font-size: 20rpx; line-height: 1.45; text-overflow: ellipsis; white-space: nowrap; }
.row-meta { display: flex; min-width: 43rpx; flex: none; flex-direction: column; align-items: flex-end; align-self: stretch; justify-content: flex-start; padding-top: 6rpx; }
.row-time { color: #A28E8B; font-size: 17rpx; line-height: 1.4; white-space: nowrap; }
.unread-badge { display: flex; align-items: center; justify-content: center; min-width: 25rpx; height: 25rpx; margin-top: 7rpx; padding: 0 5rpx; border-radius: 100rpx; background: #F36F78; color: #FFFFFF; font-size: 16rpx; line-height: 1; }
.unread-dot { width: 13rpx; height: 13rpx; margin: 11rpx 5rpx 0 0; border-radius: 50%; background: #F36F78; }
.state-panel { margin-top: 14rpx; }
.empty-panel { padding-top: 54rpx; padding-bottom: 55rpx; }
.state-mark { display: flex; align-items: center; justify-content: center; width: 68rpx; height: 68rpx; margin: 0 auto 15rpx; border-radius: 25rpx; background: #FFF0EC; color: #D17E7F; font-size: 27rpx; font-weight: 700; }
.error-mark { background: rgba(248,113,113,.13); color: #D85E66; }
.state-action { min-width: 200rpx; height: 68rpx; margin-top: 18rpx; font-size: 21rpx; line-height: 68rpx; }
.inbox-skeleton { padding: 0 18rpx; }
.skeleton-row { display: flex; align-items: center; min-height: 120rpx; border-bottom: 1rpx solid #F8EEEA; }
.skeleton-row:last-child { border-bottom: 0; }
.skeleton-avatar { width: 58rpx; height: 58rpx; flex: none; margin-right: 17rpx; border-radius: 50%; }
.skeleton-copy { display: flex; min-width: 0; flex: 1; flex-direction: column; gap: 11rpx; }
.skeleton-title { width: 39%; height: 19rpx; }
.skeleton-preview { width: 76%; height: 16rpx; }
.skeleton-time { width: 54rpx; height: 15rpx; align-self: flex-start; margin: 2rpx 0 0 12rpx; }

@media (prefers-reduced-motion: reduce) {
  .filter-chip, .inbox-row { transition: none; }
}
