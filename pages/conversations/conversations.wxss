.conversations-page { padding: 32rpx 26rpx 145rpx; }
.page-heading { margin: 0 2rpx 22rpx; }
.page-eyebrow { margin-bottom: 6rpx; color: #5A4A48; font-size: 20rpx; font-weight: 700; }
.heading-row { display: flex; align-items: center; justify-content: space-between; gap: 12rpx; }
.page-title { color: #5A4A48; font-size: 37rpx; line-height: 1.3; font-weight: 760; }
.message-count { flex: none; padding: 6rpx 12rpx; border-radius: 100rpx; background: #FCD5CE; color: #5A4A48; font-size: 20rpx; }
.page-subtitle { margin-top: 6rpx; color: #947C7A; font-size: 21rpx; }
.conversation-list { display: flex; flex-direction: column; gap: 10rpx; }
.conversation { display: flex; align-items: center; min-height: 126rpx; padding: 17rpx; border-radius: 48rpx; transition: all 0.22s ease-out; }
.conversation-pressed { transform: translateY(-12rpx); box-shadow: 0 12rpx 40rpx rgba(255,181,167,.18); }
.avatar { width: 72rpx; height: 72rpx; flex: none; margin-right: 15rpx; border-radius: 50%; background: #FCD5CE; }
.avatar-fallback { display: flex; align-items: center; justify-content: center; color: #5A4A48; font-size: 27rpx; font-weight: 700; }
.conversation-main { min-width: 0; flex: 1; }
.top-row,.bottom-row { display: flex; align-items: center; justify-content: space-between; gap: 9rpx; }
.name { overflow: hidden; color: #5A4A48; font-size: 24rpx; font-weight: 700; text-overflow: ellipsis; white-space: nowrap; }
.time { flex: none; font-size: 20rpx; }
.product { overflow: hidden; margin: 6rpx 0 5rpx; color: #947C7A; font-size: 20rpx; text-overflow: ellipsis; white-space: nowrap; }
.last-message { min-width: 0; overflow: hidden; color: #5A4A48; font-size: 21rpx; text-overflow: ellipsis; white-space: nowrap; }
.arrow { flex: none; color: #947C7A; font-size: 30rpx; }
.state-panel { margin-top: 18rpx; }
.state-icon { display: flex; align-items: center; justify-content: center; width: 78rpx; height: 78rpx; margin: 0 auto 16rpx; border-radius: 30rpx; background: #FCD5CE; color: #5A4A48; font-size: 32rpx; font-weight: 700; animation: empty-float 1.8s ease-in-out 2; }
.error-icon { background: rgba(248,113,113,.14); color: #F87171; }
.state-action { min-width: 216rpx; height: 72rpx; margin-top: 22rpx; padding: 0 24rpx; font-size: 22rpx; }
.skeleton-conversations { display: flex; flex-direction: column; gap: 13rpx; }
.skeleton-conversation { min-height: 126rpx; }
.skeleton-conversation .skeleton-avatar { width: 72rpx; height: 72rpx; flex: none; margin-right: 15rpx; border-radius: 50%; }
.skeleton-conversation .skeleton-copy { display: flex; flex: 1; flex-direction: column; gap: 11rpx; padding: 0; }
.skeleton-conversation .skeleton-line { width: 86%; }
.skeleton-conversation .short-line { width: 56%; }
