.posts-feed { padding-bottom:150rpx; }.posts-hero { display:flex; align-items:flex-end; justify-content:space-between; margin:5rpx 2rpx 17rpx; }.eyebrow { color:#947C7A; font-size:18rpx; font-weight:680; }.page-title { margin-top:3rpx; color:#5A4A48; font-size:36rpx; font-weight:750; }.compose-button { display:flex; align-items:center; gap:8rpx; height:62rpx; padding:0 18rpx; border-radius:26rpx; background:#FFB5A7; color:#5A4A48; font-size:20rpx; font-weight:700; }.compose-button text { font-size:27rpx; line-height:1; }
.scope-pill { display:flex; align-items:center; min-height:59rpx; padding:0 15rpx; border:1rpx solid #FCD5CE; border-radius:22rpx; background:#fff; }.scope-name { overflow:hidden; flex:1; margin-left:10rpx; color:#5A4A48; font-size:19rpx; text-overflow:ellipsis; white-space:nowrap; }.scope-change { margin-left:9rpx; color:#947C7A; font-size:17rpx; }.feed-intro { margin:18rpx 2rpx 10rpx; color:#806C6A; font-size:20rpx; }.post-list { display:flex; flex-direction:column; gap:12rpx; }.post-card { padding:19rpx; border-radius:28rpx; animation:post-in .25s ease-out both; }.post-pressed { opacity:.87; }.post-author { display:flex; align-items:center; }.author-avatar { display:flex; align-items:center; justify-content:center; width:58rpx; height:58rpx; flex:none; border-radius:50%; background:#FCD5CE; color:#845F5B; font-size:22rpx; font-weight:700; }.author-main { min-width:0; flex:1; margin-left:12rpx; }.author-name { color:#5A4A48; font-size:20rpx; font-weight:700; }.author-meta { overflow:hidden; margin-top:4rpx; color:#947C7A; font-size:16rpx; text-overflow:ellipsis; white-space:nowrap; }.post-type { margin-left:8rpx; padding:6rpx 10rpx; border-radius:100rpx; background:#FFF0E8; color:#B18072; font-size:16rpx; }.post-title { margin-top:15rpx; color:#5A4A48; font-size:24rpx; font-weight:720; line-height:1.45; }.post-copy { display:-webkit-box; overflow:hidden; margin-top:6rpx; color:#806C6A; font-size:20rpx; line-height:1.65; -webkit-box-orient:vertical; -webkit-line-clamp:3; }.post-image-row { display:flex; gap:8rpx; margin-top:12rpx; }.post-image-row image { width:calc(33.333% - 6rpx); height:170rpx; border-radius:15rpx; background:#FFF1E8; }.post-bottom { display:flex; align-items:center; justify-content:space-between; margin-top:13rpx; padding-top:11rpx; border-top:1rpx solid #F9E7E1; color:#947C7A; font-size:17rpx; }.comment-mark { display:flex; align-items:center; gap:7rpx; }.comment-glyph { position:relative; width:20rpx; height:15rpx; border:2rpx solid currentColor; border-radius:5rpx; }.comment-glyph::after { position:absolute; bottom:-5rpx; left:4rpx; width:6rpx; height:6rpx; border-left:2rpx solid currentColor; background:#fff; content:''; transform:skewY(-35deg); }.post-arrow { font-size:24rpx; }
.skeleton-post { display:flex; flex-direction:column; gap:15rpx; }.skeleton-author { display:flex; align-items:center; gap:12rpx; margin-bottom:4rpx; }.skeleton-avatar { width:58rpx; height:58rpx; border-radius:50%; background:#FCD5CE; }.skeleton-lines { display:flex; flex:1; flex-direction:column; gap:9rpx; }.skeleton-line { width:85%; height:16rpx; border-radius:100rpx; background:linear-gradient(90deg,#FFF7F1 0%,#FCD5CE 50%,#FFF7F1 100%); background-size:200% 100%; animation:skeleton-shimmer 1.35s ease-in-out infinite; }.short-line { width:48%; }.loading-more { padding:20rpx; color:#947C7A; text-align:center; font-size:18rpx; }
@keyframes post-in { from { opacity:0; transform:translateY(10rpx); } to { opacity:1; transform:translateY(0); } }
