.profile-edit { padding-bottom:150rpx; }.edit-card { padding:25rpx; border-radius:30rpx; }.avatar-area { display:flex; flex-direction:column; align-items:center; padding:5rpx 0 25rpx; }.avatar { width:116rpx; height:116rpx; border-radius:50%; background:#FCD5CE; }.avatar-fallback { display:flex; align-items:center; justify-content:center; color:#fff; background:#F59A9B; font-size:38rpx; font-weight:750; }.avatar-note { margin-top:9rpx; color:#947C7A; font-size:17rpx; }.field-label { margin-bottom:10rpx; color:#5A4A48; font-size:20rpx; font-weight:700; }.nickname-input { box-sizing:border-box; width:100%; height:76rpx; padding:0 16rpx; border:1rpx solid #FCD5CE; border-radius:17rpx; background:#fff; font-size:22rpx; }.input-note { margin-top:9rpx; color:#947C7A; font-size:17rpx; }.save-button { width:100%; height:76rpx; margin-top:18rpx; font-size:22rpx; }.state-action { margin-top:18rpx; }
