<view class="page favorites-page page-enter">
  <view class="favorites-head">
    <view class="page-title">我的收藏</view>
    <view class="page-intro">收藏的邻里好物都在这里，随时回来看看。</view>
  </view>
  <view wx:if="{{items.length}}" class="favorites-grid">
    <view wx:for="{{items}}" wx:key="id" class="favorite-card card" data-id="{{item.id}}" hover-class="favorite-pressed" bindtap="openItem" style="animation-delay: {{index * 40}}ms">
      <image wx:if="{{item.cover && !item.imageError}}" class="favorite-image" src="{{item.cover}}" mode="aspectFill" lazy-load="true" data-id="{{item.id}}" binderror="onImageError" />
      <view wx:else class="favorite-image image-placeholder"><view class="placeholder-mark">邻</view></view>
      <view class="favorite-copy">
        <view class="favorite-price">¥{{item.price}}</view>
        <view class="favorite-title">{{item.title}}</view>
        <view class="favorite-meta">{{item.community_name || '邻里好物'}}</view>
        <view wx:if="{{item.status === 'sold'}}" class="status status-sold">已售出</view>
      </view>
    </view>
  </view>
  <view wx:elif="{{loading}}" class="favorites-grid skeleton-grid" aria-hidden="true">
    <view class="favorite-card card"><view class="skeleton-block favorite-image"></view><view class="favorite-copy skeleton-copy"><view class="skeleton-line"></view><view class="skeleton-line short-line"></view></view></view>
    <view class="favorite-card card"><view class="skeleton-block favorite-image"></view><view class="favorite-copy skeleton-copy"><view class="skeleton-line"></view><view class="skeleton-line short-line"></view></view></view>
  </view>
  <view wx:elif="{{error}}" class="state-panel card"><view class="state-title">收藏暂时无法加载</view><view class="state-copy">检查网络连接后再试</view><button class="primary state-action" hover-class="pressed" bindtap="retry">重新加载</button></view>
  <view wx:elif="{{loggedOut}}" class="state-panel card"><view class="state-title">你已退出登录</view><view class="state-copy">登录后可以查看已收藏的好物</view><button class="primary state-action" hover-class="pressed" bindtap="login">重新登录</button></view>
  <view wx:else class="state-panel card"><view class="state-mark">藏</view><view class="state-title">还没有收藏好物</view><view class="state-copy">逛一逛，收藏喜欢的邻里好物</view><button class="primary state-action" hover-class="pressed" bindtap="goBrowse">去逛一逛</button></view>
</view>
