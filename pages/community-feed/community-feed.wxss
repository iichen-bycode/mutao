.community-feed { padding:18rpx 24rpx 145rpx; }
.community-switch { display:flex; align-items:center; gap:11rpx; min-height:112rpx; margin-bottom:15rpx; padding:16rpx; border-color:#FCD5CE; border-radius:30rpx; }
.switch-location { display:flex; align-items:center; min-width:0; flex:1; }
.switch-pin { display:flex; align-items:center; justify-content:center; width:58rpx; height:58rpx; flex:none; border-radius:21rpx; background:#FFF0EA; color:#F16F7F; }
.switch-copy { min-width:0; margin-left:12rpx; }
.switch-name { overflow:hidden; color:#5A4A48; font-size:22rpx; font-weight:700; text-overflow:ellipsis; white-space:nowrap; }
.switch-meta { margin-top:4rpx; color:#947C7A; font-size:18rpx; }
.switch-action,.all-action { flex:none; padding:9rpx 13rpx; border-radius:100rpx; background:#FFF7F1; color:#F16F7F; font-size:18rpx; }
.all-action { background:#FCD5CE; color:#5A4A48; }
.section-heading { display:flex; align-items:center; gap:10rpx; margin:0 2rpx 12rpx; }
.section-mark { width:11rpx; height:25rpx; flex:none; border-radius:7rpx; background:#FF8FA3; }
.mark-notice { background:#FFD6A5; }.mark-activity { background:#FF8FA3; }.mark-neighbor { background:#A7D7A1; }
.section-title { color:#5A4A48; font-size:24rpx; font-weight:730; }
.announcement-heading { margin-top:3rpx; }
.announcement-list { display:flex; flex-direction:column; gap:9rpx; margin-bottom:21rpx; }
.announcement-card { display:flex; gap:11rpx; padding:14rpx; border:1rpx solid #F9E8DF; border-radius:23rpx; background:#FFFCFA; }
.announcement-pin { display:flex; align-items:center; justify-content:center; width:35rpx; height:35rpx; flex:none; border-radius:50%; background:#FFF0D8; color:#A67B48; font-size:19rpx; font-weight:750; }
.announcement-copy { min-width:0; flex:1; }
.announcement-title { color:#5A4A48; font-size:20rpx; font-weight:700; }
.announcement-meta { margin-top:3rpx; color:#947C7A; font-size:17rpx; }
.announcement-content { display:-webkit-box; overflow:hidden; margin-top:5rpx; color:#6F5D5A; font-size:19rpx; line-height:1.5; -webkit-box-orient:vertical; -webkit-line-clamp:2; }
.announcement-empty { margin:0 0 20rpx; padding:13rpx 16rpx; border:1rpx dashed #FCD5CE; border-radius:20rpx; color:#947C7A; font-size:19rpx; }
.filter-scroll { margin:0 -24rpx 17rpx; white-space:nowrap; }
.filter-row { display:inline-flex; gap:9rpx; padding:0 24rpx; }
.filter-chip { height:56rpx; padding:0 19rpx; border:1rpx solid #FCD5CE; border-radius:100rpx; background:#fff; color:#947C7A; line-height:54rpx; font-size:19rpx; }
.filter-active { border-color:#FF8FA3; background:#FF8FA3; color:#fff; font-weight:680; }
.filter-pressed { opacity:.75; transform:scale(.97); }
.activity-heading { margin:0 2rpx 13rpx; }
.activity-total,.neighbors-total { margin-left:auto; padding:6rpx 11rpx; border-radius:100rpx; background:#FFF0EA; color:#947C7A; font-size:17rpx; }
.activity-list { display:flex; flex-direction:column; gap:13rpx; }
.activity-card { padding:17rpx; border-color:rgba(252,213,206,.8); border-radius:29rpx; }
.activity-author { display:flex; align-items:center; gap:11rpx; }
.avatar,.neighbor-avatar { display:flex; align-items:center; justify-content:center; width:61rpx; height:61rpx; flex:none; overflow:hidden; border-radius:50%; background:linear-gradient(140deg,#F5B89D,#F28C9D); color:#fff; font-size:22rpx; font-weight:700; }
.avatar-image image,.neighbor-image image { width:100%; height:100%; }
.author-copy { min-width:0; flex:1; }
.author-name { color:#5A4A48; font-size:21rpx; font-weight:700; }
.author-meta { overflow:hidden; margin-top:4rpx; color:#947C7A; font-size:17rpx; text-overflow:ellipsis; white-space:nowrap; }
.type-label { flex:none; padding:6rpx 10rpx; border-radius:100rpx; background:#FFF0EA; color:#B36F72; font-size:17rpx; }
.type-listing { background:#E9F7EC; color:#588D68; }
.type-help { background:#E9F7EC; color:#588D68; }
.type-wanted { background:#FFF4D7; color:#9A7852; }
.type-ride { background:#F0EDFF; color:#756AA0; }
.activity-content { margin-top:13rpx; }
.listing-title { color:#5A4A48; font-size:23rpx; line-height:1.45; font-weight:700; }
.post-title { margin-bottom:5rpx; color:#5A4A48; font-size:23rpx; line-height:1.45; font-weight:700; }
.sold-label { margin-left:8rpx; padding:4rpx 8rpx; border-radius:100rpx; background:#FCD5CE; color:#947C7A; font-size:16rpx; font-weight:500; }
.activity-description { display:-webkit-box; overflow:hidden; margin-top:5rpx; color:#6F5D5A; font-size:20rpx; line-height:1.6; -webkit-box-orient:vertical; -webkit-line-clamp:3; }
.listing-price { margin-top:8rpx; color:#F16F7F; font-size:24rpx; font-weight:750; }
.original-price { margin-left:9rpx; color:#947C7A; font-size:18rpx; font-weight:400; text-decoration:line-through; }
.post-images { display:flex; flex-wrap:wrap; gap:8rpx; margin-top:13rpx; }
.post-images image { width:calc((100% - 16rpx) / 3); height:180rpx; border-radius:16rpx; background:#FFF0EA; }
.post-images.single-image image { width:100%; max-height:360rpx; }
.activity-actions { display:flex; align-items:center; gap:9rpx; margin-top:14rpx; padding-top:11rpx; border-top:1rpx solid #FFF0EA; }
.activity-action { display:flex; align-items:center; gap:6rpx; min-height:44rpx; padding:0 7rpx; background:transparent; color:#947C7A; font-size:18rpx; line-height:1.3; }
.share-action { margin-left:auto; }
.like-mark { color:#F28C9D; font-size:23rpx; }
.like-active { color:#E95F7C; }
.comment-mark { position:relative; width:20rpx; height:15rpx; border:2rpx solid #C49E99; border-radius:6rpx; }
.comment-mark::after { position:absolute; bottom:-5rpx; left:3rpx; width:5rpx; height:5rpx; border-left:2rpx solid #C49E99; background:#fff; content:''; transform:skewY(-35deg); }
.action-pressed { opacity:.65; }
.loading-list { display:flex; flex-direction:column; gap:13rpx; }
.loading-card { padding:18rpx; border-radius:29rpx; }
.loading-author { display:flex; align-items:center; gap:11rpx; }
.loading-avatar { width:61rpx; height:61rpx; border-radius:50%; background:linear-gradient(90deg,#FFF7F1,#FCD5CE,#FFF7F1); background-size:200% 100%; animation:skeleton-shimmer 1.35s ease-in-out infinite; }
.loading-lines { display:flex; flex:1; flex-direction:column; gap:9rpx; }
.loading-lines view,.loading-line { height:15rpx; border-radius:100rpx; background:linear-gradient(90deg,#FFF7F1,#FCD5CE,#FFF7F1); background-size:200% 100%; animation:skeleton-shimmer 1.35s ease-in-out infinite; }
.loading-lines view:first-child { width:39%; }.loading-lines view:last-child { width:67%; }
.loading-line { width:85%; margin-top:16rpx; }.loading-short { width:56%; margin-top:9rpx; }
.state-panel { margin-top:14rpx; }
.state-action { min-width:210rpx; height:68rpx; margin-top:17rpx; font-size:21rpx; line-height:68rpx; }
.load-more { padding:19rpx 0; color:#947C7A; text-align:center; font-size:18rpx; }
.neighbors-section { margin-top:24rpx; }
.neighbors-card { display:flex; flex-wrap:wrap; gap:14rpx 21rpx; padding:18rpx 13rpx; border-radius:28rpx; }
.neighbor { display:flex; width:88rpx; flex-direction:column; align-items:center; gap:5rpx; }
.neighbor-avatar { width:58rpx; height:58rpx; font-size:21rpx; }
.neighbor-name { width:100%; overflow:hidden; color:#6F5D5A; text-align:center; text-overflow:ellipsis; white-space:nowrap; font-size:16rpx; }
.more-avatar { background:#FFF0EA; color:#F16F7F; font-size:28rpx; }
.activity-empty { padding:14rpx 3rpx; color:#947C7A; font-size:18rpx; }
@keyframes skeleton-shimmer { from { background-position:100% 0; } to { background-position:-100% 0; } }
@media (prefers-reduced-motion: reduce) { .loading-avatar,.loading-lines view,.loading-line,.filter-pressed { animation:none!important; transition:none!important; } }
