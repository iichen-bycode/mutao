<view class="community-feed page tab-page page-enter">
  <view class="community-switch card">
    <view class="switch-location" bindtap="chooseCommunity" hover-class="pressed">
      <view class="switch-pin"><view class="pin-glyph"></view></view>
      <view class="switch-copy">
        <view class="switch-name">{{selection && selection.mode === 'selected' && selection.location ? (selection.location.name || selection.location.address) : '全部小区'}}</view>
        <view class="switch-meta">{{selection && selection.mode === 'selected' ? '只筛选该小区的帖子' : '浏览所有小区的社区帖子'}}</view>
      </view>
    </view>
    <view class="switch-action" hover-class="pressed" bindtap="chooseCommunity">{{selectingCommunity ? '打开中' : '筛选小区'}}</view>
    <view wx:if="{{selection && selection.mode === 'selected'}}" class="all-action" catchtap="clearCommunity">全部帖子</view>
  </view>

  <view class="section-heading announcement-heading"><view class="section-mark mark-notice"></view><view class="section-title">小区公告</view></view>
  <view wx:if="{{announcements.length}}" class="announcement-list">
    <view wx:for="{{announcements}}" wx:key="id" class="announcement-card" data-id="{{item.id}}">
      <view class="announcement-pin">!</view>
      <view class="announcement-copy"><view class="announcement-title">{{item.title}}</view><view class="announcement-meta">{{item.community_name || '全部小区'}}<text wx:if="{{item.startsLabel}}"> · {{item.startsLabel}}</text></view><view class="announcement-content">{{item.content}}</view></view>
    </view>
  </view>
  <view wx:else class="announcement-empty">暂无小区公告</view>

  <scroll-view scroll-x class="filter-scroll" show-scrollbar="false"><view class="filter-row">
    <view wx:for="{{filters}}" wx:key="id" class="filter-chip {{activeType === item.id ? 'filter-active' : ''}}" data-id="{{item.id}}" hover-class="filter-pressed" bindtap="selectType">{{item.name}}</view>
  </view></scroll-view>

  <view class="section-heading activity-heading"><view class="section-mark mark-activity"></view><view class="section-title">社区帖子</view><view class="activity-total">{{total}} 条</view></view>

  <view wx:if="{{items.length}}" class="activity-list">
    <view wx:for="{{items}}" wx:key="key" class="activity-card card">
      <view class="activity-author" data-id="{{item.id}}" data-kind="{{item.item_kind}}" bindtap="openActivity">
        <view wx:if="{{item.author_avatar && !item.avatarError}}" class="avatar avatar-image"><image src="{{item.author_avatar}}" mode="aspectFill" data-id="{{item.id}}" data-kind="{{item.item_kind}}" binderror="onAvatarError" /></view>
        <view wx:else class="avatar">{{item.avatarInitial}}</view>
        <view class="author-copy"><view class="author-name">{{item.author_nickname || '邻居'}}</view><view class="author-meta">{{item.communityLabel}}<text wx:if="{{item.timeLabel}}"> · {{item.timeLabel}}</text></view></view>
        <view class="type-label type-{{item.post_type}}">{{item.typeLabel}}</view>
      </view>
      <view class="activity-content" data-id="{{item.id}}" data-kind="{{item.item_kind}}" bindtap="openActivity">
        <view class="post-title">{{item.title}}</view>
        <view class="activity-description">{{item.description}}</view>
      </view>
      <view wx:if="{{item.images.length && !item.imageError}}" class="post-images {{item.images.length === 1 ? 'single-image' : ''}}">
        <image wx:for="{{item.images}}" wx:for-item="image" wx:key="*this" src="{{image}}" mode="aspectFill" lazy-load="true" data-id="{{item.id}}" data-kind="{{item.item_kind}}" binderror="onImageError" />
      </view>
      <view class="activity-actions">
        <view class="activity-action" data-id="{{item.id}}" hover-class="action-pressed" bindtap="toggleLike"><text class="like-mark {{item.liked ? 'like-active' : ''}}">{{item.liked ? '♥' : '♡'}}</text>{{item.like_count || 0}}</view>
        <view class="activity-action" data-id="{{item.id}}" data-kind="post" hover-class="action-pressed" bindtap="openComments"><view class="comment-mark"></view>{{item.comment_count || 0}} 条评论</view>
        <button class="activity-action share-action" open-type="share" data-id="{{item.id}}" data-kind="post" data-title="{{item.title}}" hover-class="action-pressed">分享</button>
      </view>
    </view>
  </view>
  <view wx:elif="{{loading}}" class="loading-list"><view class="loading-card card"><view class="loading-author"><view class="loading-avatar"></view><view class="loading-lines"><view></view><view></view></view></view><view class="loading-line"></view><view class="loading-line loading-short"></view></view><view class="loading-card card"><view class="loading-author"><view class="loading-avatar"></view><view class="loading-lines"><view></view><view></view></view></view><view class="loading-line"></view><view class="loading-line loading-short"></view></view></view>
  <view wx:elif="{{error}}" class="state-panel card"><view class="state-title">社区动态暂时没加载出来</view><view class="state-copy">检查网络后再试一次</view><button class="primary state-action" hover-class="pressed" bindtap="refresh">重新加载</button></view>
  <view wx:elif="{{!items.length}}" class="activity-empty">暂无社区帖子</view>
  <view wx:if="{{loadingMore}}" class="load-more">正在加载更多…</view>
  <view wx:elif="{{items.length && !hasMore}}" class="load-more">已经到底啦</view>

  <view class="neighbors-section">
    <view class="section-heading neighbors-heading"><view class="section-mark mark-neighbor"></view><view class="section-title">小区邻居</view><view class="neighbors-total">{{neighborTotal}} 位活跃邻居</view></view>
    <view wx:if="{{neighbors.length}}" class="neighbors-card card">
      <view wx:for="{{neighbors}}" wx:key="id" class="neighbor" aria-label="{{item.nickname}}，最近发布了 {{item.activity_count}} 条动态"><view wx:if="{{item.avatar_url}}" class="neighbor-avatar neighbor-image"><image src="{{item.avatar_url}}" mode="aspectFill" /></view><view wx:else class="neighbor-avatar">{{item.initial}}</view><view class="neighbor-name">{{item.nickname || '邻居'}}</view></view>
      <view wx:if="{{neighborTotal > neighbors.length}}" class="neighbor neighbor-more" hover-class="pressed" bindtap="showMoreNeighbors"><view class="neighbor-avatar more-avatar">＋</view><view class="neighbor-name">更多邻居</view></view>
    </view>
    <view wx:elif="{{!loading && !error}}" class="activity-empty">暂无小区邻居</view>
  </view>

</view>
