.chat-page { box-sizing: border-box; min-height: 100vh; padding: 12rpx 21rpx 150rpx; }
.connection-bar { display: flex; align-items: center; min-height: 48rpx; padding: 0 3rpx; }
.connection-indicator { width: 12rpx; height: 12rpx; flex: none; margin-right: 9rpx; border-radius: 50%; background: #FFD6A5; }
.connection-indicator.online { background: #A7D7A1; }
.connection-indicator.offline { background: #FFD6A5; }
.connection-label { color: #947C7A; font-size: 20rpx; }
.retry-link { margin-left: auto; padding: 9rpx 12rpx; color: #5A4A48; font-size: 20rpx; }
.chat-caption { margin: 11rpx 0 20rpx; padding: 16rpx 18rpx; border: 1rpx solid #FCD5CE; border-radius: 48rpx; background: #FFFFFF; box-shadow: 0 8rpx 28rpx rgba(255,181,167,.12); }
.caption-label { margin-bottom: 3rpx; color: #947C7A; font-size: 20rpx; }
.caption-title { margin-bottom: 4rpx; color: #5A4A48; font-size: 22rpx; font-weight: 680; }
.chat-caption .muted { font-size: 20rpx; }
.messages-list { display: flex; flex-direction: column; }
.message-row { display: flex; justify-content: flex-start; margin: 12rpx 0; }
.message-row.sent { justify-content: flex-end; }
.bubble-column { display: flex; flex-direction: column; max-width: 82%; }
.message-row.sent .bubble-column { align-items: flex-end; }
.bubble { box-sizing: border-box; max-width: 100%; padding: 15rpx 18rpx; border-radius: 32rpx; font-size: 22rpx; line-height: 1.6; word-break: break-word; }
.mine { border-bottom-right-radius: 10rpx; background: #FFB5A7; color: #5A4A48; }
.theirs { border: 1rpx solid #FCD5CE; border-bottom-left-radius: 10rpx; background: #FFFFFF; color: #5A4A48; }
.message-time { margin: 5rpx 5rpx 0; color: #947C7A; font-size: 20rpx; }
.state-panel { padding-top: 61rpx; text-align: center; }
.first-message { padding-top: 86rpx; }
.state-icon { display: flex; align-items: center; justify-content: center; width: 78rpx; height: 78rpx; margin: 0 auto 15rpx; border-radius: 30rpx; background: #FCD5CE; color: #5A4A48; font-size: 32rpx; font-weight: 700; animation: empty-float 1.8s ease-in-out 2; }
.state-title { margin-bottom: 7rpx; color: #5A4A48; font-size: 25rpx; font-weight: 680; }
.state-copy { color: #947C7A; font-size: 20rpx; }
.state-action { min-width: 200rpx; height: 68rpx; margin-top: 19rpx; font-size: 21rpx; }
.composer { position: fixed; z-index: 10; right: 0; bottom: 0; left: 0; display: flex; align-items: center; gap: 11rpx; padding: 12rpx 19rpx calc(12rpx + env(safe-area-inset-bottom)); border-top: 1rpx solid #FCD5CE; background: rgba(255,247,241,.97); }
.composer input { box-sizing: border-box; min-width: 0; height: 72rpx; flex: 1; padding: 0 17rpx; border: 1rpx solid #FCD5CE; border-radius: 32rpx; background: #FFFFFF; font-size: 22rpx; }
.send-button { width: 120rpx; height: 72rpx; flex: none; border-radius: 32rpx; font-size: 21rpx; }
.chat-skeleton { display: flex; flex-direction: column; gap: 22rpx; padding-top: 25rpx; }
.skeleton-bubble { width: 67%; height: 88rpx; border-radius: 32rpx; }
.theirs-skeleton { align-self: flex-start; }
.mine-skeleton { width: 52%; height: 71rpx; align-self: flex-end; }
.short-bubble { width: 45%; height: 58rpx; }
