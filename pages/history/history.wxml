<view class="page history-page page-enter">
  <view class="history-head"><view><view class="eyebrow">只保存在这台设备</view><view class="page-title">最近浏览</view><view class="muted head-copy">看过的好物会留在这里，最多保存 30 条</view></view><view wx:if="{{items.length}}" class="clear-link" hover-class="pressed" bindtap="clear">清空</view></view>
  <view wx:if="{{items.length}}" class="history-list">
    <view wx:for="{{items}}" wx:key="id" class="history-item card" data-id="{{item.id}}" hover-class="history-pressed" bindtap="openDetail" style="animation-delay: {{index * 45}}ms">
      <image wx:if="{{item.images && item.images.length && !item.imageError}}" class="history-image" src="{{item.images[0]}}" mode="aspectFill" data-id="{{item.id}}" binderror="onImageError" /><view wx:else class="history-image image-placeholder">邻</view>
      <view class="history-main"><view class="history-title">{{item.title}}</view><view class="history-price">¥{{item.price}}</view><view class="history-meta">{{item.community_name || '邻里好物'}}<text wx:if="{{item.viewedLabel}}"> · {{item.viewedLabel}}</text></view><view wx:if="{{item.status === 'sold'}}" class="status status-sold">已售出</view></view><view class="history-arrow">›</view>
    </view>
  </view>
  <view wx:elif="{{loading}}" class="history-list skeleton-history" aria-hidden="true"><view class="history-item card"><view class="skeleton-block history-image"></view><view class="history-skeleton-copy"><view class="skeleton-line"></view><view class="skeleton-line short-line"></view><view class="skeleton-line"></view></view></view><view class="history-item card"><view class="skeleton-block history-image"></view><view class="history-skeleton-copy"><view class="skeleton-line"></view><view class="skeleton-line short-line"></view><view class="skeleton-line"></view></view></view></view>
  <view wx:else class="state-panel card"><view class="state-icon">看</view><view class="state-title">还没有浏览记录</view><view class="state-copy">去逛逛邻居分享的好物，之后可以从这里接着看</view><button class="primary state-action" hover-class="pressed" bindtap="goBrowse">去逛一逛</button></view>
</view>
