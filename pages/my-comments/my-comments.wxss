.records-page { padding-bottom:150rpx; }.page-title { margin:6rpx 0; color:#5A4A48; font-size:36rpx; font-weight:740; }.page-intro { margin-bottom:20rpx; color:#806C6A; font-size:21rpx; }
.record-list { display:flex; flex-direction:column; gap:12rpx; }.comment-card { padding:21rpx; border-radius:28rpx; }.comment-meta { display:flex; align-items:center; justify-content:space-between; }.post-type { color:#B18072; font-size:18rpx; }.comment-time { color:#947C7A; font-size:17rpx; }.post-title { overflow:hidden; margin-top:10rpx; color:#5A4A48; font-size:22rpx; font-weight:700; text-overflow:ellipsis; white-space:nowrap; }.comment-content { margin-top:11rpx; padding:13rpx 15rpx; border-radius:16rpx; background:#FFF7F1; color:#5A4A48; font-size:21rpx; line-height:1.65; word-break:break-word; }.comment-footer { display:flex; justify-content:space-between; margin-top:13rpx; color:#947C7A; font-size:18rpx; }.comment-footer text { color:#B17D75; }
.skeleton-record { display:flex; flex-direction:column; gap:14rpx; }.skeleton-line { width:82%; height:17rpx; border-radius:100rpx; background:linear-gradient(90deg,#FFF7F1 0%,#FCD5CE 50%,#FFF7F1 100%); background-size:200% 100%; animation:skeleton-shimmer 1.35s ease-in-out infinite; }.short-line { width:38%; }
