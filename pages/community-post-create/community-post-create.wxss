.post-create { padding-bottom:160rpx; }.page-title { margin:6rpx 0; color:#5A4A48; font-size:35rpx; font-weight:740; }.page-intro { margin-bottom:18rpx; color:#806C6A; font-size:20rpx; }.form-card { padding:22rpx; border-radius:28rpx; }.field-label { margin:5rpx 0 10rpx; color:#5A4A48; font-size:20rpx; font-weight:700; }.type-row { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:10rpx; margin-bottom:20rpx; }.type-option { padding:14rpx; border:1rpx solid #FCD5CE; border-radius:17rpx; background:#fff; color:#947C7A; text-align:center; font-size:19rpx; }.type-active { border-color:#FF8FA3; background:#FFF0E8; color:#9A625B; font-weight:700; }.type-placeholder { margin-bottom:20rpx; padding:15rpx; border:1rpx solid #FCD5CE; border-radius:17rpx; color:#947C7A; font-size:19rpx; text-align:center; }.type-retry { color:#B17D75; }
.community-select { display:flex; align-items:center; min-height:62rpx; margin-bottom:19rpx; padding:0 14rpx; border:1rpx solid #FCD5CE; border-radius:17rpx; background:#FFF7F1; color:#947C7A; }.community-selected { color:#5A4A48; background:#fff; }.community-copy { overflow:hidden; flex:1; margin-left:10rpx; font-size:19rpx; text-overflow:ellipsis; white-space:nowrap; }.community-action { margin-left:9rpx; color:#B17D75; font-size:17rpx; }.title-input,.content-input { box-sizing:border-box; width:100%; padding:16rpx; border:1rpx solid #FCD5CE; border-radius:16rpx; background:#fff; font-size:21rpx; }.title-input { height:76rpx; padding:0 16rpx; line-height:76rpx; }.title-input:focus { transform:none; }.content-label { margin-top:21rpx; }.content-input { min-height:260rpx; line-height:1.7; }.input-hint { margin-top:7rpx; color:#947C7A; text-align:right; font-size:16rpx; }.photo-field { margin-top:22rpx; padding-top:17rpx; border-top:1rpx solid #FCD5CE; }.photo-head { display:flex; align-items:center; justify-content:space-between; margin-bottom:11rpx; }.photo-head .field-label { margin:0; }.optional-label { margin-left:6rpx; color:#947C7A; font-size:17rpx; font-weight:400; }.photo-count { color:#947C7A; font-size:17rpx; }.photo-grid { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:10rpx; }.photo-wrap,.add-photo { position:relative; width:100%; height:170rpx; overflow:hidden; border-radius:18rpx; background:#FFF0EA; }.photo-wrap image { width:100%; height:100%; }.photo-remove { position:absolute; top:5rpx; right:5rpx; display:flex; align-items:center; justify-content:center; width:48rpx; height:48rpx; border:1rpx solid rgba(255,255,255,.8); border-radius:50%; background:rgba(90,74,72,.78); color:#fff; font-size:28rpx; line-height:1; }.photo-remove-disabled,.add-photo-disabled { opacity:.55; }.add-photo { display:flex; flex-direction:column; align-items:center; justify-content:center; border:1rpx dashed #FCD5CE; background:#FFF7F1; color:#5A4A48; font-size:18rpx; }.add-symbol { color:#FF8FA3; font-size:34rpx; line-height:1; }.uploading-note { display:flex; align-items:center; margin-top:10rpx; color:#5A4A48; font-size:17rpx; }.mini-spinner { width:13rpx; height:13rpx; margin-right:8rpx; border-radius:50%; background:#FF8FA3; }.photo-hint { margin-top:8rpx; color:#947C7A; font-size:16rpx; }.moderation-hint { margin:13rpx 5rpx; color:#947C7A; font-size:18rpx; line-height:1.5; }.submit-button { width:100%; height:76rpx; margin-top:17rpx; font-size:22rpx; line-height:76rpx; }
