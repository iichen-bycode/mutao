.post-detail { position:fixed; z-index:0; top:0; right:0; bottom:0; left:0; overflow:hidden; box-sizing:border-box; }
.post-scroll { width:100%; height:100%; }
.post-scroll-content { box-sizing:border-box; min-height:100%; padding:0 0 145rpx; }
.gallery-shell { position:relative; width:100%; height:540rpx; overflow:hidden; background:#FCD5CE; }
.gallery { width:100%; height:100%; background:#FCD5CE; }
.gallery-image { width:100%; height:100%; }
.image-fallback { display:flex; flex-direction:column; align-items:center; justify-content:center; color:#947C7A; font-size:21rpx; }
.image-fallback { width:100%; height:100%; }
.placeholder-icon { display:flex; align-items:center; justify-content:center; width:76rpx; height:76rpx; margin-bottom:12rpx; border-radius:28rpx; background:#FFF7F1; color:#5A4A48; font-size:32rpx; font-weight:700; }
.gallery-count { position:absolute; right:20rpx; bottom:20rpx; min-width:72rpx; padding:7rpx 12rpx; border-radius:100rpx; background:rgba(45,35,34,.6); color:#fff; text-align:center; font-size:19rpx; }
.post-card,.description-card,.author-card,.contact-card,.comments-section { margin:16rpx 18rpx 0; padding:22rpx; border:1rpx solid #FCD5CE; border-radius:34rpx; background:#fff; box-shadow:0 8rpx 28rpx rgba(255,181,167,.12); }
.post-meta { display:flex; align-items:center; gap:10rpx; overflow:hidden; color:#947C7A; font-size:19rpx; }
.post-kind { flex:none; margin:0; padding:6rpx 12rpx; border-radius:100rpx; background:#E9F7EC; color:#64A77A; font-size:19rpx; }
.community-label { overflow:hidden; max-width:45%; text-overflow:ellipsis; white-space:nowrap; }
.time-label { margin-left:auto; flex:none; }
.post-title { margin:14rpx 0 8rpx; color:#5A4A48; font-size:29rpx; line-height:1.5; font-weight:730; word-break:break-word; }
.activity-meta { display:flex; align-items:center; gap:7rpx; margin-top:11rpx; color:#947C7A; font-size:19rpx; }
.meta-pin { position:relative; width:12rpx; height:12rpx; margin:0 3rpx; border:2rpx solid #FF8FA3; border-radius:50% 50% 50% 0; transform:rotate(-45deg); }
.meta-dot { color:#C5AAA4; }
.meta-heart { color:#FF8FA3; }
.moderation-note { margin-top:13rpx; padding:12rpx 14rpx; border-radius:15rpx; background:#FFD6A5; color:#5A4A48; font-size:20rpx; line-height:1.55; }
.distance-row { display:flex; justify-content:space-between; margin-top:16rpx; padding-top:13rpx; border-top:1rpx solid #FFF0EA; color:#947C7A; font-size:20rpx; }
.distance-row text { color:#5A4A48; font-weight:650; }
.section-title { color:#5A4A48; font-size:24rpx; font-weight:720; }
.post-content { margin-top:10rpx; color:#6F5D5A; font-size:22rpx; line-height:1.8; white-space:pre-wrap; word-break:break-word; }
.author-card { display:flex; align-items:center; min-height:104rpx; }
.author-avatar,.comment-avatar { display:flex; align-items:center; justify-content:center; width:64rpx; height:64rpx; flex:none; border-radius:50%; background:linear-gradient(140deg,#F5B89D,#F28C9D); color:#fff; font-size:23rpx; font-weight:700; }
.author-avatar-image { margin-right:14rpx; }
.author-info { min-width:0; flex:1; margin-left:14rpx; }
.author-avatar-image + .author-info { margin-left:0; }
.author-name { color:#5A4A48; font-size:22rpx; font-weight:700; }
.author-meta { overflow:hidden; margin-top:4rpx; color:#947C7A; font-size:19rpx; text-overflow:ellipsis; white-space:nowrap; }
.message-author { width:88rpx; height:56rpx; flex:none; margin-left:12rpx; padding:0; border:1rpx solid #FF8FA3; border-radius:100rpx; background:#fff; color:#F16F7F; font-size:20rpx; line-height:54rpx; }
.contact-head,.comments-heading { display:flex; align-items:center; justify-content:space-between; }
.contact-action { padding:6rpx 13rpx; border-radius:100rpx; background:#E9F7EC; color:#5A4A48; font-size:20rpx; }
.contact-value { margin-top:10rpx; color:#5A4A48; font-size:23rpx; font-weight:680; }
.contact-help { margin-top:4rpx; color:#947C7A; font-size:19rpx; }
.comments-heading { margin-bottom:8rpx; }
.comments-count { color:#947C7A; font-size:19rpx; }
.comment-list { margin-top:5rpx; }
.comment-row { display:flex; gap:11rpx; padding:15rpx 0; border-top:1rpx solid #FFF0EA; }
.comment-avatar { width:48rpx; height:48rpx; font-size:18rpx; }
.comment-main { min-width:0; flex:1; }
.comment-head { display:flex; justify-content:space-between; gap:8rpx; }
.comment-name { color:#5A4A48; font-size:19rpx; font-weight:680; }
.comment-time { color:#947C7A; font-size:16rpx; }
.comment-content { margin-top:6rpx; color:#6F5D5A; font-size:20rpx; line-height:1.6; word-break:break-word; }
.comment-empty { padding:24rpx 5rpx 8rpx; color:#947C7A; text-align:center; font-size:19rpx; }
.comment-composer,.comment-closed { position:absolute; z-index:20; right:0; bottom:0; left:0; box-sizing:border-box; width:100%; }
.comment-composer { display:flex; align-items:center; gap:9rpx; padding:12rpx 14rpx calc(12rpx + constant(safe-area-inset-bottom)); padding:12rpx 14rpx calc(12rpx + env(safe-area-inset-bottom)); border-top:1rpx solid #FCD5CE; background:rgba(255,247,241,.98); }
.like-button { box-sizing:border-box; display:flex; align-items:center; justify-content:center; width:58rpx; min-width:58rpx; max-width:58rpx; height:58rpx; flex:0 0 58rpx; margin:0; padding:0; border:1rpx solid #FCD5CE; border-radius:50%; background:#fff; color:#6F5D5A; font-size:17rpx; white-space:nowrap; }
.like-button text { margin-right:4rpx; color:#FF8FA3; font-size:21rpx; }
.like-button.liked { border-color:#FF8FA3; color:#F16F7F; }
.comment-input { display:block; box-sizing:border-box; width:0; min-width:0; min-height:58rpx; max-height:170rpx; flex:1; align-self:center; margin:0; padding:10rpx 14rpx; border:1rpx solid #FCD5CE; border-radius:20rpx; background:#fff; color:#5A4A48; font-size:20rpx; line-height:1.5; }
.comment-input:focus { border-color:#FF8FA3; box-shadow:0 0 0 4rpx rgba(255,143,163,.16); transform:none; }
.comment-submit { box-sizing:border-box; display:flex; align-items:center; justify-content:center; width:70rpx; min-width:70rpx; max-width:70rpx; height:58rpx; flex:0 0 70rpx; margin:0; padding:0; border-radius:20rpx; font-size:18rpx; line-height:1.2; text-align:center; white-space:nowrap; }
.comment-closed { padding:22rpx 20rpx calc(22rpx + constant(safe-area-inset-bottom)); padding:22rpx 20rpx calc(22rpx + env(safe-area-inset-bottom)); border-top:1rpx solid #FCD5CE; background:#fff; color:#947C7A; text-align:center; font-size:19rpx; }
.post-loading { display:flex; flex-direction:column; gap:16rpx; }
.post-skeleton-cover { height:540rpx; }
.post-skeleton-card { display:flex; flex-direction:column; gap:14rpx; margin:16rpx 18rpx; padding:22rpx; border-radius:34rpx; }
.skeleton-line { width:85%; height:17rpx; border-radius:100rpx; background:linear-gradient(90deg,#FFF7F1 0%,#FCD5CE 50%,#FFF7F1 100%); background-size:200% 100%; animation:skeleton-shimmer 1.35s ease-in-out infinite; }
.short-line { width:48%; }
@media (prefers-reduced-motion: reduce) { .skeleton-line,.pressed,.page-enter { animation:none!important; transition:none!important; } }
