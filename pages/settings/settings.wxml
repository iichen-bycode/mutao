<view class="page settings-page page-enter">
  <view class="account-card card"><view class="account-avatar">{{profile.initial}}</view><view class="account-copy"><view class="account-name">{{profile.nickname || '邻居'}}</view><view class="account-id">睦淘社区成员</view></view><view class="account-mark">个人资料</view></view>
  <view class="settings-group"><view class="group-title">账号与社区</view><view class="settings-list card"><view class="settings-row" hover-class="pressed" bindtap="openCommunity"><view class="row-glyph location-glyph"></view><view class="row-copy"><view class="row-title">当前浏览小区</view><view class="row-note">仅在你主动选择时使用地图</view></view><view class="row-tail">更改 ›</view></view><view class="settings-row"><view class="row-glyph account-glyph">邻</view><view class="row-copy"><view class="row-title">登录账号</view><view class="row-note">账号信息由睦淘安全保存</view></view><view class="row-tail">已登录</view></view></view></view>
  <view class="settings-group"><view class="group-title">我的数据</view><view class="settings-list card"><view class="settings-row" hover-class="pressed" bindtap="clearHistory"><view class="row-glyph history-glyph"></view><view class="row-copy"><view class="row-title">清空浏览记录</view><view class="row-note">最近浏览 {{recentCount}} 件好物</view></view><view class="row-tail">清理 ›</view></view><view class="settings-row" hover-class="pressed" bindtap="clearDraft"><view class="row-glyph draft-glyph">草</view><view class="row-copy"><view class="row-title">发布草稿</view><view class="row-note">{{hasDraft ? '有一条未提交的草稿' : '当前没有保存的草稿'}}</view></view><view class="row-tail">{{hasDraft ? '删除 ›' : '管理 ›'}}</view></view></view></view>
  <view class="settings-group"><view class="group-title">帮助与说明</view><view class="settings-list card"><view class="settings-row"><view class="row-glyph about-glyph">i</view><view class="row-copy"><view class="row-title">关于睦淘</view><view class="row-note">让邻里闲置继续流转</view></view><view class="row-tail">v1.0.2</view></view><view class="settings-row"><view class="row-glyph safe-glyph">安</view><view class="row-copy"><view class="row-title">线下交易提醒</view><view class="row-note">选择安全、公开的地点完成交易</view></view></view></view></view>
  <button class="primary settings-publish" hover-class="pressed" bindtap="goPublish">发布一件闲置</button>
</view>
