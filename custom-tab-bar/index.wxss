.tab-shell {
  position: fixed;
  z-index: 99;
  right: 0;
  bottom: 0;
  left: 0;
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
  border-top: 1rpx solid #FCE4DC;
  background: rgba(255,255,255,.97);
  box-shadow: 0 -7rpx 22rpx rgba(167,113,101,.06);
}
.tabbar { display:flex; align-items:center; height:100rpx; }
.tab-item { display:flex; flex:1; flex-direction:column; align-items:center; justify-content:center; height:100%; color:#9A8580; transition:color .2s ease; }
.tab-selected { color:#D9566B; }
.tab-icon { position:relative; box-sizing:border-box; display:flex; flex:none; align-items:center; justify-content:center; width:52rpx; height:52rpx; margin-bottom:2rpx; color:currentColor; }
.tab-label { min-height:22rpx; color:currentColor; font-size:18rpx; line-height:22rpx; }

/* Home: a compact house with a clear doorway. */
.tab-home::before { position:absolute; bottom:6rpx; left:14rpx; width:24rpx; height:18rpx; box-sizing:border-box; border:3rpx solid currentColor; border-top:0; border-radius:2rpx 2rpx 3rpx 3rpx; content:''; }
.home-roof { position:absolute; top:5rpx; left:9rpx; width:34rpx; height:28rpx; }
.home-roof::before,.home-roof::after { position:absolute; top:10rpx; width:19rpx; height:3rpx; border-radius:2rpx; background:currentColor; content:''; }
.home-roof::before { left:0; transform:rotate(-40deg); transform-origin:right center; }
.home-roof::after { right:0; transform:rotate(40deg); transform-origin:left center; }
.home-door { position:absolute; bottom:6rpx; left:23rpx; width:7rpx; height:11rpx; box-sizing:border-box; border:3rpx solid currentColor; border-bottom:0; border-radius:2rpx 2rpx 0 0; }

/* Community: three neighbors grouped inside the same 44rpx icon frame. */
.community-person { position:absolute; bottom:7rpx; width:14rpx; height:28rpx; }
.person-left { left:4rpx; z-index:1; transform:scale(.84); transform-origin:bottom center; }
.person-right { right:4rpx; z-index:1; transform:scale(.84); transform-origin:bottom center; }
.person-center { left:19rpx; z-index:2; }
.person-head { position:absolute; top:0; left:2rpx; width:10rpx; height:10rpx; box-sizing:border-box; border:3rpx solid currentColor; border-radius:50%; background:#fff; }
.person-body { position:absolute; bottom:0; left:0; width:14rpx; height:17rpx; box-sizing:border-box; border:3rpx solid currentColor; border-radius:9rpx 9rpx 5rpx 5rpx; background:#fff; }

/* Messages: one rounded bubble, a small tail, and three centered dots. */
.tab-message::before { position:absolute; top:9rpx; left:7rpx; width:38rpx; height:29rpx; box-sizing:border-box; border:3rpx solid currentColor; border-radius:9rpx; content:''; }
.message-tail { position:absolute; bottom:9rpx; left:14rpx; width:9rpx; height:9rpx; box-sizing:border-box; border-bottom:3rpx solid currentColor; border-left:3rpx solid currentColor; background:#fff; transform:skewY(-35deg); }
.message-dot { position:absolute; top:22rpx; width:4rpx; height:4rpx; border-radius:50%; background:currentColor; }
.message-dot-one { left:16rpx; }.message-dot-two { left:24rpx; }.message-dot-three { left:32rpx; }

/* Me: a single head and softly rounded shoulders. */
.tab-me::before { position:absolute; bottom:5rpx; left:9rpx; width:34rpx; height:19rpx; box-sizing:border-box; border:3rpx solid currentColor; border-radius:18rpx 18rpx 9rpx 9rpx; content:''; }
.me-head { position:absolute; top:4rpx; left:19rpx; width:14rpx; height:14rpx; box-sizing:border-box; border:3rpx solid currentColor; border-radius:50%; background:#fff; }

/* The center publish action stays raised and keeps its space without a label. */
.tab-publish { position:relative; z-index:1; }
.tab-publish .tab-icon { width:80rpx; height:80rpx; margin-top:-24rpx; margin-bottom:1rpx; border:3rpx solid #fff; border-radius:50%; background:#E96D7E; color:#fff; box-shadow:0 6rpx 16rpx rgba(233,109,126,.24); }
.tab-plus::before,.tab-plus::after { position:absolute; top:37rpx; left:23rpx; width:34rpx; height:3rpx; border-radius:3rpx; background:#fff; content:''; }
.tab-plus::after { transform:rotate(90deg); }
.tab-publish-label-spacer { width:1rpx; height:22rpx; flex:none; margin-top:1rpx; }

/* Community compose shortcut uses the same coral and restrained shadow. */
.community-compose-fab { position:absolute; z-index:98; right:28rpx; bottom:calc(126rpx + constant(safe-area-inset-bottom)); bottom:calc(126rpx + env(safe-area-inset-bottom)); display:flex; align-items:center; justify-content:center; width:88rpx; height:88rpx; box-sizing:border-box; border:2rpx solid rgba(255,255,255,.9); border-radius:50%; background:#E96D7E; box-shadow:0 8rpx 18rpx rgba(233,109,126,.22); }
.community-compose-pressed { opacity:.86; transform:scale(.94); }
.community-compose-plus { position:relative; width:34rpx; height:34rpx; }
.community-compose-plus::before,.community-compose-plus::after { position:absolute; top:15rpx; left:1rpx; width:32rpx; height:3rpx; border-radius:3rpx; background:#fff; content:''; }
.community-compose-plus::after { transform:rotate(90deg); }
